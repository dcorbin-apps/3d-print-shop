{
  "name": "@3d-print-shop/server",
  "version": "1.1.3",
  "type": "module",
  "files": [
    "dist",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "echo \"tests run from root\" && exit 0"
  },
  "keywords": [],
  "author": "dcorbin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
