    "directory": "packages/server"
  },
  "devDependencies": {
    "@3d-print-shop/octoprint-sim": "workspace:*",
    "@types/busboy": "^1",
    "@types/express": "^5",
    "@types/ws": "^8",
    "typescript": "^5.9.3"
  },
  "bin": {
    "3d-print-shop": "./dist/main.js",
    "3d-print-shop-install": "./install.sh"
  },
  "dependencies": {
    "@3d-print-shop/client": "workspace:*",
    "busboy": "^1.6.0",
    "commander": "^14.0.2",
