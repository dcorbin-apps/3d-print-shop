{
  "name": "3d-print-shop",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "shop": "tsx packages/server/src/main.ts",
    "ui": "yarn workspace @3d-print-shop/ui dev",
    "build": "yarn workspaces foreach -A -p --topological-dev run build",
    "typecheck": "yarn workspaces foreach -A -p --topological-dev run typecheck && tsc --noEmit -p scripts/tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "ut": "./scripts/test.sh --testPathIgnorePatterns /tests/acceptance/ /tests/assumptions/",
    "at": "./scripts/test.sh tests/acceptance",
    "assumptions": "./scripts/test.sh tests/assumptions",
    "test": "./scripts/test.sh --testPathIgnorePatterns /tests/assumptions/",
    "release": "./scripts/release.sh"
  },
  "keywords": [],
  "author": "dcorbin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcorbin-apps/3d-print-shop.git"
  },
  "description": "A service that takes print jobs and gets them onto a printer",
  "devDependencies": {
    "@jest/globals": "^29.4.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^15",
    "jest": "^29.4.5",
    "prettier": "^3",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  },
  "packageManager": "yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538",
  "engines": {
    "node": ">=24.16 <25"
  }
}
